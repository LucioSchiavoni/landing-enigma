---
import Logo from './Logo.astro';

const links = [
  { href: '#servicios', label: 'Servicios', index: '02' },
  { href: '#proyectos', label: 'Proyectos', index: '03' },
  { href: '#nosotros', label: 'Nosotros', index: '04' },
];
---

<header class="fixed inset-x-3 top-3 z-40 sm:inset-x-5 sm:top-4 lg:inset-x-6" data-nav-bar>
  <nav
    aria-label="Principal"
    class="flex h-14 items-center justify-between border border-line bg-surface pr-2 pl-4 lg:h-[4.25rem] lg:pr-2.5 lg:pl-6"
  >
    <a href="/" class="text-white" aria-label="Enigma Builders, inicio">
      <Logo />
    </a>

    <ul class="hidden items-center gap-10 lg:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="group flex items-center gap-3 text-[0.9375rem] font-medium text-white">
              {link.label}
              <span class="grid size-7 place-items-center bg-white/8 text-accent transition-colors duration-200 group-hover:bg-brand group-hover:text-white" aria-hidden="true">
                <svg class="size-3" viewBox="0 0 12 12" fill="none">
                  <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href="#contacto" class="btn btn-primary h-10 px-4 text-sm lg:h-12 lg:px-6 lg:text-[0.9375rem]">Contacto</a>
      <button
        type="button"
        class="grid size-10 place-items-center bg-white/8 text-white transition-colors hover:bg-white/14 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 5h14M1 11h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div class="drawer-backdrop fixed inset-0 z-40 bg-ink/70 lg:hidden" data-menu-backdrop></div>

<aside
  id="menu-movil"
  class="drawer fixed inset-y-0 right-0 z-50 flex w-[min(22rem,88vw)] flex-col border-l border-line bg-surface lg:hidden"
  aria-label="Menú"
  data-menu
>
  <div class="flex h-[4.25rem] items-center justify-between border-b border-line pr-3 pl-5">
    <span class="tag">[ Menú ]</span>
    <button
      type="button"
      class="grid size-10 place-items-center bg-white/8 text-white transition-colors hover:bg-white/14"
      aria-label="Cerrar menú"
      data-menu-close
    >
      <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="m3 3 10 10M13 3 3 13" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <ul class="flex flex-col px-5 pt-4">
    {
      links.map((link) => (
        <li class="border-b border-line">
          <a href={link.href} class="flex items-center justify-between py-5 text-2xl font-medium tracking-[-0.02em] text-white" data-menu-link>
            {link.label}
            <span class="tag text-accent/70">[ {link.index} ]</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto p-5">
    <a href="#contacto" class="btn btn-primary w-full" data-menu-link>Contacto</a>
  </div>
</aside>

<script src="../scripts/nav.ts"></script>
