---
import Logo from './Logo.astro';

const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#nosotros', label: 'Nosotros' },
  { href: '#contacto', label: 'Contacto' },
];

const year = new Date().getFullYear();
---

<footer class="footer relative z-20">
  <div class="flex w-full flex-col gap-8 px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:px-12">
    <a href="/" class="w-fit text-white" aria-label="Enigma Builders, volver al inicio">
      <Logo />
    </a>
    <nav aria-label="Pie de página">
      <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href="https://instagram.com/enigma.builders" class="footer-link" target="_blank" rel="noopener">
            Instagram<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        </li>
      </ul>
    </nav>
    <div class="flex flex-col gap-1 lg:items-end">
      <p class="tag">Descifrar, construir, entregar.</p>
      <p class="text-xs text-muted">© {year} Enigma Builders</p>
    </div>
  </div>
</footer>
