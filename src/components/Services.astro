---
import { siSolidity, siTypescript } from 'simple-icons';

const inputs = ['WhatsApp', 'Email', 'Formulario web', 'Documentos'];
const outputs = ['Agenda la cita', 'Actualiza el CRM', 'Genera la factura', 'Avisa al equipo'];
const rows = [12.5, 37.5, 62.5, 87.5];

const steps = [
  { index: '01', title: 'Conversamos', text: 'Entendemos tu problema, tu negocio y qué resultado necesitas.' },
  { index: '02', title: 'Proponemos', text: 'Te presentamos una solución concreta, con alcance y plazos claros.' },
  { index: '03', title: 'Construimos', text: 'Entregamos por etapas, mostrando avances reales.' },
  { index: '04', title: 'Lanzamos y acompañamos', text: 'Puesta en producción y soporte para que todo siga funcionando.' },
];
---

<section id="servicios" class="surface-light relative z-20 border-t border-brand" aria-labelledby="servicios-title">
  <div class="w-full px-3 pt-24 pb-16 sm:px-5 lg:px-6 lg:pt-28 lg:pb-24">
    <p class="tag">[ 02 ] Servicios</p>
    <h2 id="servicios-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em] sm:text-4xl">Servicios</h2>

    <div class="services mt-6 lg:mt-8">
      <article class="service service-dark lg:col-span-2 lg:row-span-2" aria-labelledby="servicio-ia" data-reveal>
        <div class="flex flex-col gap-4">
          <p class="tag">[ 01 ] Especialidad</p>
          <h3 id="servicio-ia" class="text-3xl leading-tight font-semibold tracking-[-0.04em] sm:text-4xl">Agentes de IA y automatización</h3>
          <p class="max-w-xl leading-relaxed text-muted">
            Agentes que atienden a tus clientes por WhatsApp, gestionan citas, procesan documentos y conectan tus herramientas. Del primer flujo a un sistema funcionando en producción.
          </p>
        </div>

        <figure class="flow" data-reveal-flow>
          <div class="dot-grid flow-grid" aria-hidden="true"></div>
          <figcaption class="sr-only">
            El agente recibe mensajes por WhatsApp, email, formulario web o documentos, entiende y decide, y ejecuta acciones: agenda la cita, actualiza el CRM, genera la factura y avisa al equipo.
          </figcaption>
          <div class="flow-lines" aria-hidden="true">
            <svg class="flow-svg flow-svg-in" viewBox="0 0 100 100" preserveAspectRatio="none">
              {rows.map((y) => <path class="flow-line" d={`M26 ${y} C31 ${y} 31 50 36 50`} />)}
            </svg>
            <svg class="flow-svg flow-svg-out" viewBox="0 0 100 100" preserveAspectRatio="none">
              {rows.map((y) => <path class="flow-line flow-line-out" d={`M64 50 C69 50 69 ${y} 74 ${y}`} />)}
            </svg>
          </div>
          <div class="flow-col flow-col-in">
            <p class="tag flow-label">Entradas</p>
            <ul class="flow-list flow-in" aria-hidden="true">
              {inputs.map((input) => <li><span>{input}</span></li>)}
            </ul>
          </div>
          <div class="flow-hub" aria-hidden="true">
            <span class="flow-node flow-node-in"></span>
            <span class="flow-node flow-node-out"></span>
            <span class="flow-bot">
              <svg viewBox="0 0 32 32" fill="none">
                <path d="M16 3.5V7.5M4 14v5M28 14v5" stroke="currentColor" stroke-width="1.5" />
                <rect x="14.5" y="1.5" width="3" height="3" fill="currentColor" />
                <rect x="7" y="7.75" width="18" height="14.5" stroke="currentColor" stroke-width="1.5" />
                <rect class="flow-bot-eye" x="11" y="12.5" width="3" height="3.5" fill="currentColor" />
                <rect class="flow-bot-eye" x="18" y="12.5" width="3" height="3.5" fill="currentColor" />
                <path d="M12.5 19h7M11 22.25v4.25h10v-4.25" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </span>
            <span class="flow-hub-copy">
              <span class="tag">Agente IA</span>
              <span class="flow-hub-text">Entiende y decide</span>
            </span>
          </div>
          <div class="flow-col flow-col-out">
            <p class="tag flow-label">Acciones</p>
            <ul class="flow-list flow-out" aria-hidden="true">
              {outputs.map((output) => <li><span>{output}</span></li>)}
            </ul>
          </div>
          <span class="corner corner-tl" aria-hidden="true"></span>
          <span class="corner corner-tr" aria-hidden="true"></span>
          <span class="corner corner-bl" aria-hidden="true"></span>
          <span class="corner corner-br" aria-hidden="true"></span>
        </figure>
      </article>

      <article class="service service-light" aria-labelledby="servicio-software" data-reveal data-reveal-delay="1">
        <svg class="service-logo" viewBox="0 0 24 24" aria-hidden="true"><path d={siTypescript.path} /></svg>
        <div class="flex flex-col gap-4">
          <p class="tag">[ 02 ]</p>
          <h3 id="servicio-software" class="text-2xl leading-tight font-semibold tracking-[-0.04em]">Software a medida</h3>
          <p class="leading-relaxed text-graphite/70">
            SaaS, plataformas, paneles internos, webs y landings de alto rendimiento. Desde un MVP en semanas hasta productos pensados para crecer.
          </p>
        </div>
      </article>

      <article class="service service-light" aria-labelledby="servicio-seguridad" data-reveal data-reveal-delay="2">
        <svg class="service-logo service-logo-tall" viewBox="0 0 24 24" aria-hidden="true"><path d={siSolidity.path} /></svg>
        <div class="flex flex-col gap-4">
          <p class="tag">[ 03 ]</p>
          <h3 id="servicio-seguridad" class="text-2xl leading-tight font-semibold tracking-[-0.04em]">Seguridad y Web3</h3>
          <p class="leading-relaxed text-graphite/70">
            Revisión de seguridad de aplicaciones y sitios web antes de su lanzamiento, y desarrollo de contratos inteligentes e integraciones blockchain bajo consulta.
          </p>
        </div>
      </article>
    </div>

    <div class="mt-16 lg:mt-24">
      <p class="tag">[ Proceso ]</p>
      <h3 class="mt-3 text-2xl font-semibold tracking-[-0.04em] sm:text-3xl">Cómo trabajamos</h3>
      <ol class="steps mt-8" data-reveal-stagger>
        {
          steps.map((step) => (
            <li class="step">
              <span class="tag">[ {step.index} ]</span>
              <h4 class="mt-6 text-xl font-semibold tracking-[-0.03em]">{step.title}</h4>
              <p class="mt-2 leading-relaxed text-graphite/70">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script src="../scripts/reveal.ts"></script>
<script src="../scripts/flow.ts"></script>
