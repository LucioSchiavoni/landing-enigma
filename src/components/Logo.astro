---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg class="h-6 w-8 shrink-0" viewBox="0 0 32 24" fill="none" aria-hidden="true">
    <path d="M10 4.5 3.5 12l6.5 7.5M22 4.5l6.5 7.5-6.5 7.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" />
    <path d="M18.25 3 13.75 21" class="stroke-brand-soft" stroke-width="2.6" stroke-linecap="square" />
  </svg>
  <span class="flex flex-col text-[0.9375rem] leading-[0.95] font-semibold tracking-[-0.02em]">
    <span>enigma</span>
    <span>Builders</span>
  </span>
</span>
